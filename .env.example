# Server Configuration
PORT=3000
NODE_ENV=development

# GetResponse API Configuration
# Get API Key from: https://app.getresponse.com/integrations/api
GETRESPONSE_API_KEY=your_getresponse_api_key_here

# GetResponse List/Campaign IDs
# Use separate lists for newsletter subscribers + contact leads.
# Get these IDs from GetResponse: https://app.getresponse.com/contacts
GETRESPONSE_LIST_ID_NEWSLETTER=your_newsletter_campaign_id_here
GETRESPONSE_LIST_ID_CONTACTS=your_contact_leads_campaign_id_here

# Optional: GetResponse custom field IDs (for extra contact data sync)
# Create custom fields in GetResponse and use their customFieldId values.
GETRESPONSE_CUSTOM_FIELD_ID_COMPANY=
GETRESPONSE_CUSTOM_FIELD_ID_PHONE=
GETRESPONSE_CUSTOM_FIELD_ID_MESSAGE=

# Email Configuration (for contact form notifications)
# Using SMTP - works with Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_or_app_password

# Admin email to receive contact form submissions
ADMIN_EMAIL=admin@yourdomain.com

# Database Configuration
# SQLite database path (can be relative, will create ./data/ folder)
DATABASE_PATH=./data/app.db

# Contact anti-spam (lightweight)
# Minimum time between form open and submit in seconds (0 disables check)
CONTACT_MIN_SUBMIT_SECONDS=3

# Rate limit per IP for contact submissions
CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX=5

# Temporary diagnostics: log submitted contact field values in server logs
# Keep false in normal operation to reduce personal data in logs
CONTACT_DEBUG_LOG_VALUES=false

# If true, debug logs can include raw contact field values (NOT recommended in production)
# Keep false for GDPR-friendly pseudonymized previews.
CONTACT_DEBUG_LOG_INCLUDE_RAW=false

# Comma-separated hidden honeypot field names (must stay empty)
CONTACT_HONEYPOT_FIELDS=company_fax

# Optional browser redirect targets after contact form submit
CONTACT_SUCCESS_REDIRECT_URL=
CONTACT_ERROR_REDIRECT_URL=

# Cookie Consent / GDPR Configuration
# Comma-separated allowlist for browser calls from Webflow domains.
# Example: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=

# Consent record retention period in months (default: 12)
CONSENT_RETENTION_MONTHS=12

# Optional secret salt used when hashing user identifiers in consent logs
CONSENT_HASH_SALT=
