# Server Configuration
PORT=3000
NODE_ENV=development

# GetResponse API Configuration
# Get API Key from: https://app.getresponse.com/integrations/api
GETRESPONSE_API_KEY=your_getresponse_api_key_here

# GetResponse List/Campaign IDs
# Use separate lists for newsletter subscribers + contact leads.
# Get these IDs from GetResponse: https://app.getresponse.com/contacts
GETRESPONSE_LIST_ID_NEWSLETTER=your_newsletter_campaign_id_here
GETRESPONSE_LIST_ID_CONTACTS=your_contact_leads_campaign_id_here

# Optional: GetResponse custom field IDs (for extra contact data sync)
# Create custom fields in GetResponse and use their customFieldId values.
GETRESPONSE_CUSTOM_FIELD_ID_COMPANY=
GETRESPONSE_CUSTOM_FIELD_ID_PHONE=
GETRESPONSE_CUSTOM_FIELD_ID_MESSAGE=

# Email Configuration (for contact form notifications)
# Using SMTP - works with Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_or_app_password

# Admin email to receive contact form submissions
ADMIN_EMAIL=admin@yourdomain.com

# Database Configuration
# SQLite database path (can be relative, will create ./data/ folder)
DATABASE_PATH=./data/app.db
